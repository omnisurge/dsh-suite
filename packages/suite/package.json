    "lib/types.js",
    "lib/upgrade.d.ts",
    "lib/upgrade.js",
    "locale",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-gateway",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "omnisurge": {
    "verifiedRuntimes": [
      {
        "version": "0.2.0-rc.2",
        "gateScope": "G1-G4"
      },
      {
        "version": "0.2.1-rc.2",
        "gateScope": "G1-G5"
      },
      {
        "version": "0.2.1-rc.3",
        "gateScope": "G1-G5"
      },
      {
        "version": "0.2.1-rc.3",
        "platform": "win32",
        "gateScope": "G6"
      },
      {
        "version": "0.2.1-rc.5",
        "gateScope": "G1-G5"
      }
    ],
    "note": "Runtimes this generation was actually exercised on. The Client compares the official boot manifest's release version against this list and reports anything else as unverified. Admission to load is a separate decision owned by engines.dsh (ADR-015, this repository's own decision log).",
    "platforms": {
      "verified": [
        "darwin",
        "win32"
      ],
      "unverified": [
        "linux"
      ],
      "note": "macOS verified by this repository gates (G1-G5). Windows verified by G6 on an installed desktop runtime (install+load+three cards+save); it is not a full in-repo G1-G5 gate run. Linux never run."
    }
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-api-gateway": ">=0.2.0-rc.2 <1.0.0",
    "@deepseek-ai/dsh-app-boot": ">=0.2.0-rc.2 <1.0.0",
    "@deepseek-ai/dsh-credentials": ">=0.2.0-rc.2 <1.0.0",
    "@deepseek-ai/dsh-plugin-manager": ">=0.2.0-rc.2 <1.0.0",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.2 <1.0.0",
    "@deepseek-ai/dsh-typert-protocol": ">=0.2.0-rc.2 <1.0.0",
    "@deepseek-ai/dsh-web": ">=0.2.0-rc.2 <1.0.0",
    "@deepseek-ai/schemastery": "^3.18.5"
  },
  "engines": {
    "dsh": ">=0.2.0-rc.2 <1.0.0"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0"
  }
}
