    "lib/ocr-usage.js",
    "lib/recovery.d.ts",
    "lib/recovery.js",
    "lib/runtime-guard.d.ts",
    "lib/runtime-guard.js",
    "lib/searxng.d.ts",
    "lib/searxng.js",
    "lib/skills-catalog.d.ts",
    "lib/skills-catalog.js",
    "lib/skills-local.d.ts",
    "lib/skills-local.js",
    "lib/skills-manage.d.ts",
    "lib/skills-manage.js",
    "lib/tar.d.ts",
    "lib/tar.js",
    "lib/team-config.d.ts",
