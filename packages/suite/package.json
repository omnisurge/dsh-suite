{
  "name": "@omnisurge/dsh-suite",
  "version": "0.2.2",
  "private": true,
  "description": "Independent extensions for DeepSeek Harness. Includes web search.",
  "type": "module",
  "exports": {
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*": "./locale/*",
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./types": {
      "types": "./lib/types.d.ts",
      "default": "./lib/types.js"
    },
    "./searxng": {
      "types": "./lib/searxng.d.ts",
      "default": "./lib/searxng.js"
    },
    "./mcp-dual": {
      "types": "./lib/mcp-dual.d.ts",
      "default": "./lib/mcp-dual.js"
    },
    "./mcp-oauth": {
      "types": "./lib/mcp-oauth.d.ts",
      "default": "./lib/mcp-oauth.js"
    },
    "./login-gateway": {
      "types": "./lib/login-gateway.d.ts",
      "default": "./lib/login-gateway.js"
    },
    "./agent-teams": {
      "types": "./lib/agent-teams.d.ts",
      "default": "./lib/agent-teams.js"
    },
    "./ocr-types": {
      "types": "./lib/ocr-types.d.ts",
      "default": "./lib/ocr-types.js"
    }
  },
  "files": [
    "components",
    "cordis.patch.yml",
    "lib/agent-teams.d.ts",
    "lib/agent-teams.js",
    "lib/ambient.d.ts",
    "lib/ambient.js",
    "lib/build-protocol.d.ts",
    "lib/build-protocol.js",
    "lib/client.js",
    "lib/components.d.ts",
    "lib/components.js",
    "lib/config.d.ts",
    "lib/config.js",
    "lib/development.d.ts",
    "lib/development.js",
    "lib/dsh-home.d.ts",
    "lib/dsh-home.js",
    "lib/environment-notes.d.ts",
    "lib/environment-notes.js",
    "lib/github-release.d.ts",
    "lib/github-release.js",
    "lib/heal.d.ts",
    "lib/heal.js",
    "lib/host.d.ts",
    "lib/host.js",
    "lib/index.d.ts",
    "lib/index.js",
    "lib/limit-mode.d.ts",
    "lib/limit-mode.js",
    "lib/limits.json",
    "lib/login-gateway.d.ts",
    "lib/login-gateway.js",
    "lib/loopback-origin.d.ts",
    "lib/loopback-origin.js",
    "lib/mcp-dual.d.ts",
    "lib/mcp-dual.js",
    "lib/mcp-oauth.d.ts",
    "lib/mcp-oauth.js",
    "lib/mcp-purpose.d.ts",
    "lib/mcp-purpose.js",
    "lib/mcp-servers.d.ts",
    "lib/mcp-servers.js",
    "lib/ocr-baidu.d.ts",
    "lib/ocr-baidu.js",
    "lib/ocr-contract.d.ts",
    "lib/ocr-contract.js",
    "lib/ocr-core.d.ts",
    "lib/ocr-core.js",
    "lib/ocr-raster.d.ts",
    "lib/ocr-raster.js",
    "lib/ocr-reconcile.d.ts",
    "lib/ocr-reconcile.js",
    "lib/ocr-service.d.ts",
    "lib/ocr-service.js",
    "lib/ocr-tencent.d.ts",
    "lib/ocr-tencent.js",
    "lib/ocr-types.d.ts",
    "lib/ocr-types.js",
