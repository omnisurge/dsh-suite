      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-gateway",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "omnisurge": {
    "verifiedRuntimes": [
      {
        "version": "0.2.2-rc.5",
        "gateScope": "G1-G5"
      }
    ],
    "note": "Runtimes this generation was actually exercised on. The Client compares the official boot manifest's release version against this list and reports anything else as unverified. Admission to load is a separate decision owned by engines.dsh (ADR-015, this repository's own decision log).",
    "platforms": {
      "verified": [
        "darwin"
      ],
      "unverified": [
        "win32",
        "linux"
      ],
      "note": "This 0.3.7 stable release targets macOS DSH 0.2.2-rc.5; final artifact-bound G5 results and limitations are recorded in docs/evidence/release-0.3.7.md. Windows and Linux remain unverified; NAS execution is frozen by ADR0048. Earlier rc.3 and internal-iteration results are historical only, not this stable release."
    }
  },
